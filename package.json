{
  "name": "@whoisddd/dsh-approval-notify",
  "description": "Minimal DSH web GUI plugin that raises native browser notifications or fallback toasts for approval, question, plan-review, and completed-session reminders.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "test:notify": "vitest run tests/notification-behavior.spec.ts",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "immer": "10.1.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "unrun": "^0.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "zustand": "^4.4.7"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "CHANGELOG.md"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.3.4"
}
